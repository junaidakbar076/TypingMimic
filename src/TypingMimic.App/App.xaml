<Application x:Class="TypingMimic.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="#E9EDF5"/><Setter Property="BorderBrush" Value="#CAD2E0"/><Setter Property="Foreground" Value="#18243C"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="BorderBrush" Value="#B9C5D8"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#B9C5D8"/><Setter Property="Background" Value="White"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,4"/></Style>
  <Style TargetType="Label"><Setter Property="Padding" Value="0,8,0,4"/></Style>
 </Application.Resources>
</Application>
